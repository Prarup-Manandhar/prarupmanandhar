---
const navItems = [
  { label: "Home", href: "#home" },
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Work", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="site-header">
  <nav id="main-nav" aria-label="Primary navigation">
    <a class="brand" href="#home" aria-label="Prarup Manandhar, home">PM</a>
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <a class="nav-cta" href="mailto:prarupmanandhar98@gmail.com">Email me</a>
  </nav>
</header>

<script>
  const header = document.querySelector(".site-header");
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("#main-nav a[href^='#']"));
  const sections = Array.from(document.querySelectorAll<HTMLElement>("section[id]"));

  const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 12);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) => {
          const active = link.getAttribute("href") === `#${entry.target.id}`;
          link.classList.toggle("active", active);
          if (active) link.setAttribute("aria-current", "page");
          else link.removeAttribute("aria-current");
        });
      }
    },
    { rootMargin: "-35% 0px -55%", threshold: 0 },
  );

  sections.forEach((section) => observer.observe(section));
</script>

<style>
  .site-header {
    position: fixed;
    top: 1rem;
    left: 50%;
    z-index: 100;
    width: min(calc(100% - 2rem), 72rem);
    transform: translateX(-50%);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.75rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid transparent;
    border-radius: 1.2rem;
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .site-header.is-scrolled nav {
    border-color: var(--line);
    background: rgba(11, 13, 15, 0.82);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.32);
    backdrop-filter: blur(18px);
  }

  .brand {
    display: grid;
    width: 2.65rem;
    height: 2.65rem;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--surface);
    color: var(--white);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  ul {
    display: flex;
    align-items: center;
    gap: clamp(0.45rem, 2vw, 1.75rem);
    list-style: none;
  }

  li a {
    position: relative;
    color: var(--white-icon);
    font-size: 0.86rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease;
  }

  li a::after {
    position: absolute;
    right: 0;
    bottom: -0.55rem;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--sec);
    content: "";
    opacity: 0;
    transform: scaleX(0.4);
    transition: opacity 180ms ease, transform 180ms ease;
  }

  li a:hover, li a.active { color: var(--white); }
  li a.active::after { opacity: 1; transform: scaleX(1); }

  .nav-cta {
    border-radius: 0.85rem;
    background: var(--sec);
    color: #10140d;
    padding: 0.7rem 1rem;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .site-header { top: auto; bottom: 0; width: 100%; }
    nav, .site-header.is-scrolled nav {
      min-height: 4.6rem;
      border-right: 0;
      border-bottom: 0;
      border-left: 0;
      border-radius: 1.2rem 1.2rem 0 0;
      background: rgba(11, 13, 15, 0.94);
      padding: 0.7rem 1rem 0.9rem;
      backdrop-filter: blur(18px);
    }
    .brand, .nav-cta { display: none; }
    ul { width: 100%; justify-content: space-between; gap: 0.25rem; }
    li a { font-size: 0.68rem; }
    li a::after { bottom: -0.4rem; }
  }
</style>
