---
import LogoWall from "./logoWall.astro";

const highlights = [
  { value: "6+", label: "Years building enterprise software" },
  { value: "Java 8–21", label: "Production experience across modern Java" },
  { value: "Full stack", label: "Backend, frontend, cloud, and delivery" },
];

const capabilities = [
  {
    id: "backend",
    short: "Backend",
    title: "Backend engineering",
    summary: "Designing the service layer where business rules, security, data integrity, and performance come together.",
    items: ["Java 8–21, Spring Boot, Spring MVC, Hibernate, JPA, and JDBC", "Secure REST APIs with validation, exception handling, OAuth2, JWT, and RBAC", "Spring Batch workflows for scheduled processing, migration, and reporting"],
    stack: ["Java", "Spring Boot", "REST", "Spring Security", "JPA"],
  },
  {
    id: "architecture",
    short: "Architecture",
    title: "Distributed architecture",
    summary: "Breaking complex workflows into scalable services with clear boundaries, resilient communication, and observable behavior.",
    items: ["Kafka producers and consumers with partitioning, replication, retries, and offset management", "Monolith-to-microservices modernization and event-driven integration patterns", "Relational and NoSQL data design across Oracle, PostgreSQL, MySQL, MongoDB, and DynamoDB"],
    stack: ["Kafka", "Microservices", "PostgreSQL", "MongoDB", "DynamoDB"],
  },
  {
    id: "delivery",
    short: "Full stack",
    title: "Full-stack product delivery",
    summary: "Owning features across the API and interface so the complete experience is cohesive, testable, and production-ready.",
    items: ["Angular 8–19, TypeScript, RxJS, Material UI, and reusable component systems", "Complex forms, route guards, interceptors, lazy loading, and state management", "API integration, responsive design, accessibility, and cross-browser compatibility"],
    stack: ["Angular", "TypeScript", "RxJS", "HTML", "CSS"],
  },
  {
    id: "platform",
    short: "Platform",
    title: "Cloud platform & DevOps",
    summary: "Turning software into repeatable, supportable releases through infrastructure automation and disciplined delivery pipelines.",
    items: ["AWS services including ECS, EC2, S3, RDS, Lambda, API Gateway, and CloudWatch", "Containerized delivery with Docker, Kubernetes, Terraform, and CloudFormation", "Jenkins-based CI/CD, automated quality gates, rolling updates, and rollback strategies"],
    stack: ["AWS", "Docker", "Kubernetes", "Terraform", "Jenkins"],
  },
  {
    id: "reliability",
    short: "Reliability",
    title: "Security, quality & reliability",
    summary: "Building operational confidence into the system instead of treating it as a final deployment step.",
    items: ["Distributed tracing and monitoring with OpenTelemetry, Splunk, CloudWatch, and New Relic", "Automated testing with JUnit, Mockito, Jasmine, Karma, Postman, JMeter, and K6", "SonarQube quality enforcement, vulnerability remediation, performance tuning, and production support"],
    stack: ["OpenTelemetry", "Splunk", "JUnit", "SonarQube", "JMeter"],
  },
  {
    id: "leadership",
    short: "Leadership",
    title: "Senior technical leadership",
    summary: "Raising the engineering bar through sound decisions, clear communication, and hands-on support for the people around me.",
    items: ["Architecture discussions, code reviews, pair programming, and technical walkthroughs", "Mentoring junior developers and reinforcing secure coding and team standards", "Incident resolution, production support, cross-team collaboration, and Agile delivery"],
    stack: ["System design", "Code review", "Mentoring", "Production ownership", "Agile"],
  },
];
---

<section id="home" class="hero page-shell">
  <div class="hero-copy">
    <div class="availability"><span></span> Senior Software Engineer at Fidelity Investments</div>
    <p class="eyebrow">Hi, I’m Prarup Manandhar.</p>
    <h1>I build dependable software for <em>complex systems.</em></h1>
    <p class="hero-summary">
      Full-stack engineer specializing in Java, Spring Boot, event-driven architecture,
      Angular, and AWS. I turn enterprise requirements into secure, scalable systems tha
      teams can operate with confidence.
    </p>
    <div class="hero-actions">
      <a class="primary-button" href="#projects">Explore my work</a>
      <a class="secondary-button" href="https://www.linkedin.com/in/prarup-manandhar/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="secondary-button" href="mailto:prarupmanandhar98@gmail.com">Email me</a>
    </div>
  </div>

  <figure class="hero-visual">
    <img
      src="/prarup-manandhar.webp"
      alt="Prarup Manandhar, Senior Software Engineer"
      width="1040"
      height="1024"
      fetchpriority="high"
      decoding="async"
    />
  </figure>
</section>

<section id="about" class="about page-shell">
  <div class="about-heading">
    <p class="section-kicker">About</p>
    <h2>Engineering from backend to browser.</h2>
  </div>
  <div class="about-copy">
    <p>
      I’m a senior software engineer with experience delivering enterprise applications
      across financial services, insurance, and retail. My work spans API design,
      distributed services, modern web interfaces, database modernization, and cloud delivery.
    </p>
    <p>
      I care about software that is understandable, observable, and resilient. Alongside
      hands-on development, I contribute through system design, code reviews, production
      support, pair programming, and mentoring engineers.
    </p>
  </div>

  <div class="highlights">
    {highlights.map((item) => (
      <article>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
      </article>
    ))}
  </div>

  <LogoWall />

  <div class="capabilities">
    <div>
      <p class="section-kicker">Capabilities</p>
      <h2>What I bring to a team.</h2>
      <p class="capabilities-intro">
        A product-minded approach to architecture, implementation, delivery, and reliability.
      </p>
    </div>
    <div class="capability-tabs" data-capability-tabs>
      <div class="capability-tablist" role="tablist" aria-label="Senior engineering capabilities">
        {capabilities.map((capability, index) => (
          <button
            id={"capability-tab-" + capability.id}
            role="tab"
            type="button"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={"capability-panel-" + capability.id}
            tabindex={index === 0 ? 0 : -1}
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            {capability.short}
          </button>
        ))}
      </div>
      <div class="capability-panels">
      {capabilities.map((capability, index) => (
        <section
          id={"capability-panel-" + capability.id}
          class="capability-panel"
          role="tabpanel"
          aria-labelledby={"capability-tab-" + capability.id}
          hidden={index !== 0}
        >
          <p class="capability-index">Capability / {String(index + 1).padStart(2, "0")}</p>
          <h3>{capability.title}</h3>
          <p class="capability-summary">{capability.summary}</p>
          <ul>{capability.items.map((item) => <li>{item}</li>)}</ul>
          <div class="capability-stack" aria-label={capability.title + " technologies"}>
            {capability.stack.map((item) => <span>{item}</span>)}
          </div>
        </section>
      ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-capability-tabs]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[role='tab']"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[role='tabpanel']"));

    const activate = (index: number, moveFocus = true) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.tabIndex = selected ? 0 : -1;
        panels[tabIndex].hidden = !selected;
      });
      if (moveFocus) tabs[index].focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activate(index, false));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        if (event.key === "Home") activate(0);
        else if (event.key === "End") activate(tabs.length - 1);
        else if (event.key === "ArrowDown") activate((index + 1) % tabs.length);
        else activate((index - 1 + tabs.length) % tabs.length);
      });
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    min-height: 100svh;
    padding-block: 8rem 5rem;
  }

  .hero-copy { max-width: 48rem; }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(18, 21, 24, 0.7);
    color: var(--white-icon);
    padding: 0.5rem 0.8rem;
    font-size: 0.76rem;
    font-weight: 600;
  }

  .availability span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--sec);
    box-shadow: 0 0 0 0.3rem var(--sec-soft);
  }

  .eyebrow {
    margin-bottom: 0.7rem;
    color: var(--white-icon);
    font-size: clamp(0.95rem, 2vw, 1.1rem);
  }

  h1 {
    max-width: 13ch;
    font-size: clamp(3.4rem, 8vw, 6.7rem);
    font-weight: 590;
    letter-spacing: -0.065em;
    line-height: 0.94;
  }

  h1 em { color: var(--sec); font-style: normal; }

  .hero-summary {
    max-width: 42rem;
    margin-top: 2rem;
    color: var(--white-icon);
    font-size: clamp(1rem, 2vw, 1.18rem);
  }

  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .hero-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    border-radius: 0.85rem;
    padding: 0.75rem 1.05rem;
    font-size: 0.86rem;
    font-weight: 750;
    text-decoration: none;
    transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
  }

  .hero-actions a:hover { transform: translateY(-2px); }
  .primary-button { background: var(--sec); color: #10140d; }
  .secondary-button { border: 1px solid var(--line); background: var(--surface); color: var(--white); }
  .secondary-button:hover { border-color: rgba(158, 227, 111, 0.45); }

  .hero-visual {
    position: relative;
    width: min(100%, 32rem);
    aspect-ratio: 1 / 1;
    justify-self: end;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.6rem;
    background: #0e1113;
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.35);
  }

  .hero-visual::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
    content: "";
    pointer-events: none;
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(0.96) contrast(1.02);
  }

  .about { padding-block: 7rem; border-top: 1px solid var(--line); }

  .about-heading, .capabilities {
    display: grid;
    grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 6rem);
  }

  .about h2 {
    margin-top: 0.6rem;
    font-size: clamp(2.1rem, 5vw, 4.4rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1.02;
  }

  .about-copy { color: var(--white-icon); font-size: clamp(1rem, 2vw, 1.15rem); }
  .about-copy p + p { margin-top: 1rem; }

  .highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-block: 4rem 2rem;
  }

  .highlights article {
    min-height: 10rem;
    border: 1px solid var(--line);
    border-radius: 1.2rem;
    background: rgba(18, 21, 24, 0.7);
    padding: 1.4rem;
  }

  .highlights strong { display: block; color: var(--sec); font-size: clamp(1.45rem, 3vw, 2.3rem); }
  .highlights span { display: block; margin-top: 1.8rem; color: var(--white-icon); font-size: 0.84rem; }

  .capabilities { align-items: start; margin-top: 5rem; }
  .capabilities-intro { max-width: 28rem; margin-top: 1.2rem; color: var(--white-icon); }

  @media (max-width: 850px) {
    .hero { grid-template-columns: 1fr; min-height: auto; padding-top: 7rem; }
    .hero-visual { justify-self: center; }
    .about-heading, .capabilities { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .hero { padding-bottom: 4rem; }
    h1 { font-size: clamp(3rem, 16vw, 4.6rem); }
    .availability { align-items: flex-start; border-radius: 1rem; }
    .highlights { grid-template-columns: 1fr; }
    .highlights article { min-height: 8rem; }
    .about { padding-block: 5rem; }
  }
</style>

<style is:global>
  .capability-tabs {
    display: grid;
    grid-template-columns: minmax(9rem, 0.42fr) minmax(0, 1fr);
    min-height: 34rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 1.35rem;
    background: var(--surface);
  }

  .capability-tablist {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--line);
    background: #0e1113;
    padding: 0.65rem;
  }

  .capability-tablist button {
    display: grid;
    width: 100%;
    grid-template-columns: 2rem 1fr;
    gap: 0.6rem;
    align-items: center;
    border: 0;
    border-radius: 0.8rem;
    background: transparent;
    color: var(--white-icon);
    padding: 0.9rem 0.75rem;
    font: inherit;
    font-size: 0.76rem;
    font-weight: 700;
    text-align: left;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .capability-tablist button span {
    color: rgba(158, 227, 111, 0.55);
    font-size: 0.62rem;
  }

  .capability-tablist button:hover {
    color: var(--white);
  }

  .capability-tablist button[aria-selected="true"] {
    background: var(--sec-soft);
    color: var(--white);
  }

  .capability-tablist button[aria-selected="true"] span {
    color: var(--sec);
  }

  .capability-panels {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px),
      radial-gradient(circle at 95% 5%, rgba(158, 227, 111, 0.11), transparent 45%);
    background-size: 3.25rem 3.25rem, 3.25rem 3.25rem, auto;
  }

  .capability-panel {
    min-height: 100%;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: rgba(18, 21, 24, 0.86);
    animation: capability-enter 260ms ease both;
  }

  .capability-panel[hidden] {
    display: none;
  }

  .capability-index {
    color: var(--sec);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .capability-panel h3 {
    max-width: 12ch;
    margin-top: 1.1rem;
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 580;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .capability-summary {
    max-width: 38rem;
    margin-top: 1.25rem;
    color: var(--white-icon);
    font-size: 0.9rem;
  }

  .capability-panel ul {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.8rem;
    list-style: none;
  }

  .capability-panel li {
    position: relative;
    border-top: 1px solid var(--line);
    color: rgba(241, 244, 239, 0.82);
    padding: 0.85rem 0 0 1.25rem;
    font-size: 0.82rem;
  }

  .capability-panel li::before {
    position: absolute;
    top: 1.25rem;
    left: 0;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--sec);
    content: "";
    box-shadow: 0 0 0 0.25rem var(--sec-soft);
  }

  .capability-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 2rem;
  }

  .capability-stack span {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(11, 13, 15, 0.72);
    color: var(--white-icon);
    padding: 0.35rem 0.6rem;
    font-size: 0.64rem;
    font-weight: 650;
  }

  @keyframes capability-enter {
    from { opacity: 0; transform: translateY(0.45rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 760px) {
    .capability-tabs {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .capability-tablist {
      flex-direction: row;
      overflow-x: auto;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      scrollbar-width: none;
    }

    .capability-tablist::-webkit-scrollbar {
      display: none;
    }

    .capability-tablist button {
      min-width: 7.8rem;
      grid-template-columns: 1fr;
      gap: 0.2rem;
      text-align: center;
    }

    .capability-panel {
      min-height: 33rem;
    }
  }
</style>
